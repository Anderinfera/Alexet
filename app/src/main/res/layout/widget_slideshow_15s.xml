<?xml version="1.0" encoding="utf-8"?>
<!-- Slideshow widget: the home screen shows the next photo every 15 seconds -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/slideshow_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_slideshow_background"
    android:clipToOutline="true"
    tools:targetApi="31">

    <AdapterViewFlipper
        android:id="@+id/slideshow_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="15000"
        android:loopViews="true" />

    <TextView
        android:id="@+id/slideshow_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/slideshow_widget_empty"
        android:textColor="#E6FFFFFF"
        android:textSize="13sp" />
</FrameLayout>
